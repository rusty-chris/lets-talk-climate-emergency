# deploy/production.env.example — TEMPLATE for the production env file.
#
# Copy to a root-only file OUTSIDE the repo checkout on the server:
#
#   install -m 600 -o root -g root deploy/production.env.example /root/climate-chat.env
#   $EDITOR /root/climate-chat.env       # fill in every REPLACE-ME value
#
# and pass it with --env-file (service/DEPLOYMENT.md §9). The filled file
# is NEVER committed (it carries ANTHROPIC_API_KEY); this template holds
# placeholders only and is scanned by gitleaks like everything else
# (finding #35). Values here override the dev-safe defaults interpolated
# in docker-compose.yml.

# --- Ingress (deploy/Caddyfile) --------------------------------------
# The registered domain Caddy serves with automatic HTTPS. DNS A/AAAA
# records must point at the server BEFORE first boot or ACME issuance
# fails (and retries).
CLIMATE_CHAT_DOMAIN=REPLACE-ME.example.org

# The public origin: chart permalinks, CSV links, and the transparency
# links all render absolutely off this. Path-routed single origin
# (deploy/Caddyfile), so this is simply https://<domain>.
CLIMATE_CHAT_SITE_URL=https://REPLACE-ME.example.org

# Behind the Caddy ingress the api's socket peer is ALWAYS the caddy
# container, so the per-IP rate limiter must key on the first
# X-Forwarded-For entry (service/rate_limit.py resolve_client_ip).
# Safe because the Caddyfile configures no trusted_proxies: Caddy
# replaces any client-supplied X-Forwarded-For with the real client
# address. Keep 0 in every stack NOT fronted by Caddy.
CLIMATE_CHAT_TRUSTED_PROXY=1

# --- Budget (the GATE — DEPLOYMENT.md §6) ----------------------------
# Owner-confirmed values against the <£20/month target (owner action,
# DEPLOYMENT.md §8). Breach fails closed to the read-only paused state.
CLIMATE_CHAT_DAILY_BUDGET_USD=REPLACE-ME
CLIMATE_CHAT_OPUS_SUBCAP_USD=REPLACE-ME

# --- Release artifacts (DEPLOYMENT.md §3 + RELEASE-READINESS.md §(d)) -
# All in-container paths: the image is built from the clone at the
# release tag AFTER the release artifacts are generated into the working
# tree, so they are baked in at `--build` time (Dockerfile COPY . .).
CLIMATE_CHAT_CORPUS_VERSION=REPLACE-ME
CLIMATE_CHAT_CORPUS_VINTAGE=REPLACE-ME
CLIMATE_CHAT_STARTER_CACHE_DIR=/app/REPLACE-ME-release-starter-cache
CLIMATE_CHAT_THRESHOLD_ARTIFACT=/app/REPLACE-ME-threshold.json
CLIMATE_CHAT_DATASET_MANIFEST=/app/REPLACE-ME-dataset_manifest.yaml
CLIMATE_CHAT_CHART_PACK_DIR=/app/REPLACE-ME-chart-pack

# --- Service wiring (compose-network defaults, stated explicitly) -----
CLIMATE_CHAT_QDRANT_URL=http://qdrant:6333
CLIMATE_CHAT_LOG_DIR=/tmp/climate-chat-logs
CLIMATE_CHAT_RATE_LIMIT_PER_MINUTE=60

# --- Secrets ----------------------------------------------------------
# Presence-checked only; never stored on config or logged. Real value
# goes ONLY into the root-only copy of this file on the server.
ANTHROPIC_API_KEY=REPLACE-ME-real-key-goes-in-the-root-only-copy
