# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/

# Virtual env / package management
.venv/
.python-version

# Test / lint caches
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Streamlit
.streamlit/secrets.toml

# Raw dataset downloads (never committed; URLs + sha256 recorded in
# datasets/manifest.yaml and reviews/spike-04-chart-findings.md)
data/

# Local env files
.env
.env.*
!.env.example

# Spike source documents (issue #2): real NCA5 / CC-BY PDFs are fetched locally,
# never committed. URLs + sha256 are recorded in reviews/spike-02-parsing-findings.md.
data/spike/
.claude/
.secrets

# Ingest run records (review #143): first-party operational output of
# `ingest_corpus`, regenerated per run — recorded on disk, not in git.
corpus/ingest_run.json

# Fetched corpus artefacts (issue #7 / review #145): open-tier text is
# re-fetchable from its manifest pins (ADR-023 spirit); non-open text
# never lands here at all (review #144).
corpus/*.pdf
corpus/*.html

# Rerank perf logs (review #176): first-party operational evidence,
# recorded on disk / uploaded as CI artifacts — never committed by
# accident. Deliberately committed samples carry the PROJECT-OPERATIONAL
# first-line marker (see evals/perf/README.md).
evals/perf/*.csv
